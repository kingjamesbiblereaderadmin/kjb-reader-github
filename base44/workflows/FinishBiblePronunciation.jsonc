{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "finish_bible_pronunciation",
      "version": "1.1",
      "namespace": "base44"
    },
    "do": [
      {
        "repair_missing_recordings": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "repairPronunciationBatch",
            "args": {
              "backfill": true
            }
          },
          "then": "record_full_titles",
          "x-base44": {
            "title": "Refresh remaining audited recordings",
            "description": "Skip completed repairs"
          }
        }
      },
      {
        "record_full_titles": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "recordBookAnnouncements",
            "args": {
              "backfill": true
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Finish full-title announcements",
            "description": "Reuse recorded titles and chapter numbers"
          }
        }
      }
    ]
  },
  "name": "Finish Bible Pronunciation Repairs",
  "description": "Completes only the audited h5 to h28 recording refreshes in saved batches. Completed revision keys are skipped. The finite schedule archives after 720 runs; no speech is generated when the repair queue is empty.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "Asia/Singapore",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "after_count",
      "ends_on_date": null,
      "ends_after_count": 720
    }
  }
}