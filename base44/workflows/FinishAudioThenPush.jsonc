{
  "name": "Finish Audio Then Push Builds",
  "description": "Starts the Android and Apple app builds on GitHub when the app is published, once nothing is left in the audio work. Nothing is built on a schedule any more.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "app_publish",
      "events": [
        "published"
      ]
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "finish_audio_then_push_builds",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "check_and_push": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "finishAndPush",
            "args": {
              "force": true
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Build the apps when you publish",
            "description": "Runs only after you press Publish"
          }
        }
      }
    ]
  }
}