{
  "name": "TtsStat",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "maxLength": 32,
      "description": "Which counter this row holds: library, spend, push, or bundle_refresh"
    },
    "verses": {
      "type": "integer",
      "description": "Verses with a cached clip, or completed units for the named counter"
    },
    "chars": {
      "type": "integer",
      "description": "Characters voiced at the last successful count"
    },
    "recentChars": {
      "type": "integer",
      "description": "Characters voiced in the ten minutes before that count, or total units for bundle_refresh"
    },
    "hourChars": {
      "type": "integer",
      "description": "Characters voiced in the hour before the last successful library count"
    },
    "updated": {
      "type": "string",
      "maxLength": 40,
      "description": "When the count was taken"
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}