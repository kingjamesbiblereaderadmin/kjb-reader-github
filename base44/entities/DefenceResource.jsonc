{
  "name": "DefenceResource",
  "properties": {
    "category": {
      "description": "Category name for grouping (e.g. 'KJB Defence', 'NKJV Exposed')",
      "type": "string"
    },
    "desc": {
      "description": "Short description of the resource",
      "type": "string"
    },
    "label": {
      "description": "Display label for the link button",
      "type": "string"
    },
    "label2": {
      "description": "Display label for the optional second link button",
      "type": "string"
    },
    "order": {
      "default": 0,
      "description": "Sort order within the category (lower first)",
      "type": "integer"
    },
    "title": {
      "description": "Resource title",
      "type": "string"
    },
    "url": {
      "description": "Link URL",
      "type": "string"
    },
    "url2": {
      "description": "Optional second link URL",
      "type": "string"
    }
  },
  "required": [
    "category",
    "title",
    "desc",
    "url"
  ],
  "type": "object",
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}