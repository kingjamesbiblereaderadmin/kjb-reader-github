{
  "name": "TtsClip",
  "type": "object",
  "properties": {
    "hash": {
      "type": "string",
      "description": "sha256 of voice + spoken text — the cache key"
    },
    "voice": {
      "type": "string",
      "description": "ElevenLabs voice id the clip was generated with"
    },
    "chars": {
      "type": "integer",
      "description": "Characters sent to ElevenLabs (what was billed)"
    },
    "url": {
      "type": "string",
      "description": "Public URL of the generated mp3"
    },
    "ref": {
      "type": "string",
      "description": "Verse reference this clip was first generated for (e.g. 'John 3:16')"
    }
  },
  "required": [
    "hash",
    "voice",
    "url"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {}
  }
}
