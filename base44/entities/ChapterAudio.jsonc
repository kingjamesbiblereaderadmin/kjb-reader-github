{
  "name": "ChapterAudio",
  "type": "object",
  "properties": {
    "abbr": {
      "type": "string",
      "description": "Book abbreviation (e.g. 'gen', 'joh')"
    },
    "book": {
      "type": "string",
      "description": "Full book name (e.g. 'Genesis')"
    },
    "chapter": {
      "type": "integer",
      "description": "Chapter number"
    },
    "file_url": {
      "type": "string",
      "description": "Public URL of the rendered MP3 for this chapter"
    },
    "duration_sec": {
      "type": "number",
      "description": "Length of the audio in seconds"
    },
    "bytes": {
      "type": "integer",
      "description": "File size in bytes"
    },
    "voice": {
      "type": "string",
      "description": "Voice/model that rendered this chapter (e.g. 'en_GB-alba-medium')"
    },
    "timings": {
      "type": "array",
      "description": "Per-verse start/end offsets in seconds, for read-along highlighting",
      "items": {
        "type": "object",
        "properties": {
          "verse": {
            "type": "integer"
          },
          "start": {
            "type": "number"
          },
          "end": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": [
    "abbr",
    "chapter",
    "file_url"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}