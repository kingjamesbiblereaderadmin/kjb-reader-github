er included them"],["SPAN",{"class":"flex-shrink-0 inline-flex items-center px-2 py-0.5 rounded-md font-sans text-[10px] font-semibold uppercase tracking-wide bg-purple-100 text-purple-700 dark:bg-purple-500/20 dark:text-purple-300 border border-purple-300/60 dark:border-purple-500/30"},"UI"]]]],["DIV",{"class":"rounded-2xl border border-border bg-white/80 dark:bg-card/80 backdrop-blur-sm shadow-sm p-6 border-l-4 border-l-amber-500"},["DIV",{"class":"flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-3 mb-4"},["SPAN",{"class":"inline-flex items-center px-3 py-1 rounded-full border font-sans text-xs font-semibold bg-gradient-to-r from-amber-500 to-orange-500 text-white border-amber-600/40"},"v0.4.226"],["SPAN",{"class":"font-sans text-sm text-muted-foreground"},"September 1, 2026"]],["UL",{"class":"space-y-2.5"},["LI",{"class":"flex items-start gap-2.5 font-sans text-sm leading-relaxed text-foreground/90"},["SPAN",{"class":"flex-shrink-0 w-1.5 h-1.5 rounded-full bg-accent mt-[0.55em]"}],["SPAN",{"class":"flex-1"},"Replaced the native book/chapter dropdowns in Read mode with custom-built popup lists — native <select> elements had unreliable click hit-testing inside Chrome side panels for some users regardless of panel size or zoom level, so this is entirely our own click handling instead"],["SPAN",{"class":"flex-shrink-0 inline-flex items-center px-2 py-0.5 rounded-md font-sans text-[10px] font-semibold uppercase tracking-wide bg-amber-100 text-amber-700 dark:bg-amber-500/20 dark:text-amber-300 border border-amber-300/60 dark:border-amber-500/30"},"Improved"]]]],["DIV",{"class":"rounded-2xl border border-border bg-white/80 dark:bg-card/80 backdrop-blur-sm shadow-sm p-6 border-l-4 border-l-emerald-500"},["DIV",{"class":"flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-3 mb-4"},["SPAN",{"class":"inline-flex items-center px-3 py-1 rounded-full border font-sans text-xs font-semibold bg-gradient-to-r from-emerald-500 to-emerald-600 text-white border-emerald-600/4